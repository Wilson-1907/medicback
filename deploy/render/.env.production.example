APP_NAME=PHV Hospital Console
HOSPITAL_NAME=Nyeri Town Health Center
CLINIC_SITE_NAME=Nyeri Town Health Center

DB_HOST=
DB_PORT=3306
DB_NAME=phv_pilot
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
DB_SSL_MODE=required
DB_SSL_CA=

AFRICASTALKING_MODE=production

# Sandbox block can stay empty in production.
AFRICASTALKING_SANDBOX_USERNAME=sandbox
AFRICASTALKING_SANDBOX_API_KEY=
AFRICASTALKING_SANDBOX_SMS_FROM=
AFRICASTALKING_SANDBOX_WHATSAPP_FROM=
AFRICASTALKING_SANDBOX_SMS_URL=https://api.sandbox.africastalking.com/version1/messaging
AFRICASTALKING_SANDBOX_WHATSAPP_URL=https://api.sandbox.africastalking.com/version1/whatsapp/message

# Fill these when Africa's Talking provides live credentials (SMS only — leave WHATSAPP_FROM empty when using Mteja).
AFRICASTALKING_PROD_USERNAME=
AFRICASTALKING_PROD_API_KEY=
AFRICASTALKING_PROD_SMS_FROM=
AFRICASTALKING_PROD_WHATSAPP_FROM=
AFRICASTALKING_PROD_SMS_URL=https://api.africastalking.com/version1/messaging
AFRICASTALKING_PROD_WHATSAPP_URL=https://api.africastalking.com/version1/whatsapp/message

# WhatsApp with Mteja — template broadcast API (see hospital_portal/docs/MTEJA_WHATSAPP_GO_LIVE.md)
WHATSAPP_PROVIDER=mteja
MTEJA_APP_ID=5666
MTEJA_API_KEY=
MTEJA_VIRTUAL_NUMBER=+254142830423
MTEJA_API_URL=https://api.sentry.mteja.io/api/whatsapp-template
MTEJA_LANG_CODE_EN=en_US
MTEJA_LANG_CODE_SW=sw

# Meta Cloud (only if Mteja provides separate Meta tokens)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
