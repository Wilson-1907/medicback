APP_NAME=HPV Hospital Console
HOSPITAL_NAME=Nyeri Town Health Center
AFYA_RAFIKI_NAME=Afya Rafiki
CLINIC_SITE_NAME=Nyeri Town Health Center
WIPE_DATA_PASSWORD=Adminpass

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=phv_pilot
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_SSL_MODE=disable
DB_SSL_CA=

# Africa's Talking
AFRICASTALKING_MODE=sandbox

# Sandbox
AFRICASTALKING_SANDBOX_USERNAME=sandbox
AFRICASTALKING_SANDBOX_API_KEY=
AFRICASTALKING_SANDBOX_SMS_FROM=30065
AFRICASTALKING_SANDBOX_WHATSAPP_FROM=
AFRICASTALKING_SANDBOX_SMS_URL=https://api.sandbox.africastalking.com/version1/messaging
AFRICASTALKING_SANDBOX_WHATSAPP_URL=https://api.sandbox.africastalking.com/version1/whatsapp/message

# Production
AFRICASTALKING_PROD_USERNAME=
AFRICASTALKING_PROD_API_KEY=
AFRICASTALKING_PROD_SMS_FROM=
AFRICASTALKING_PROD_WHATSAPP_FROM=
AFRICASTALKING_PROD_SMS_URL=https://api.africastalking.com/version1/messaging
AFRICASTALKING_PROD_WHATSAPP_URL=https://api.africastalking.com/version1/whatsapp/message

# WhatsApp via Mteja template broadcast API (recommended with Mteja App ID + API Key)
WHATSAPP_PROVIDER=mteja
MTEJA_APP_ID=5666
MTEJA_API_KEY=
MTEJA_VIRTUAL_NUMBER=+254142830423
MTEJA_API_URL=https://api.sentry.mteja.io/api/whatsapp-template
MTEJA_LANG_CODE_EN=en
MTEJA_LANG_CODE_SW=sw
# If your Mteja template name differs, override:
# MTEJA_TEMPLATE_AFYA_WELCOME_EN=exact_name_in_mteja_dashboard

# Optional: Meta Cloud API (only if Mteja gives separate Meta tokens — not App ID / API Key)
# WHATSAPP_PROVIDER=cloud
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0

# Groq AI (patient caring auto-replies) — get key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Cron — schedule GET /cron_run_reminders.php every 5-15 min (optional ?key=...)
CRON_SECRET=
# Clinic timezone for drip scheduling (default Africa/Nairobi)
APP_TIMEZONE=Africa/Nairobi
